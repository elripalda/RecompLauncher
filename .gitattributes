# Flatpak/Flathub validators reject CRLF.
packaging/** text eol=lf
# Shell scripts the launcher embeds and runs on a Mac (include_str!): a CR would break them.
src-tauri/src/*.sh text eol=lf
# UI tests read JavaScript and Rust source with LF line endings on every platform.
ui/*.js text eol=lf
src-tauri/src/**/*.rs text eol=lf
