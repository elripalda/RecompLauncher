    </release>
    <release version="0.90.0-beta.35" date="2026-11-10">
      <description>
        <p>New versions show up when RecompLauncher opens, smoother updates and more accurate play time.</p>
      </description>
    </release>
    <release version="0.90.0-beta.34" date="2026-11-10">
