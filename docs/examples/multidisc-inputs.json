    {"id": "disc2", "label": "Disc 2", "role": "disc", "formats": [{"type": "file", "extensions": ["iso"]}]},
    {"id": "disc3", "label": "Disc 3", "role": "disc", "formats": [{"type": "file", "extensions": ["iso"]}]},
    {"id": "disc4", "label": "Disc 4", "role": "disc", "formats": [{"type": "file", "extensions": ["iso"]}]},
    {"id": "dlc1", "label": "DLC pack 1", "role": "dlc", "optional": true, "formats": [{"type": "file"}]},
    {"id": "dlc2", "label": "DLC pack 2", "role": "dlc", "optional": true, "formats": [{"type": "file"}]},
    {"id": "dlc3", "label": "DLC pack 3", "role": "dlc", "optional": true, "formats": [{"type": "file"}]}
  ],
  "prepare": {
    "program": ["example-importer.exe"],
